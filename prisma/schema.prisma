// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  password          String?
  email_verified_at DateTime?
  profile_picture   String?

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], name: "user_role", onDelete: Cascade, onUpdate: Cascade)

  auth_token AuthToken[] @relation("user_auth_token")

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  @@map("user")
}

model Role {
  id   String   @id @default(uuid())
  name String   @unique
  type RoleType @default(USER)

  user       User[]       @relation(name: "user_role")
  permission Permission[] @relation(name: "role_permission")

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  @@map("role")
}

model Permission {
  id      String          @id @default(uuid())
  subject String
  scope   PermissionScope
  actions String

  role Role[] @relation(name: "role_permission")

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  @@map("permission")
}

enum PermissionScope {
  ANY
  OWN
}

enum RoleType {
  SYSTEM
  USER
}

model AuthToken {
  id         String        @id @default(uuid())
  user_id    String
  user       User          @relation(fields: [user_id], references: [id], name: "user_auth_token", onDelete: Cascade)
  token      String        @unique
  type       AuthTokenType
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime      @default(now())

  @@map("auth_token")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
