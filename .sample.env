# AUTH
AUTH_SECRET=""

# DATABASE
DATABASE_URL=""

# AWS S3
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_PREFIX=""

# UI
NEXT_PUBLIC_PRIMARY_COLOR=""
NEXT_PUBLIC_SECONDARY_COLOR=""
NEXT_PUBLIC_ACCENT_COLOR_1=""
NEXT_PUBLIC_ACCENT_COLOR_2=""
NEXT_PUBLIC_BLACK_COLOR=""
NEXT_PUBLIC_WHITE_COLOR=""
NEXT_PUBLIC_THEME=""

# MAIL
MAIL_PROVIDER=""
MAIL_FROM=""
# Site origin the mail templates and notification links are built from, e.g.
# https://app.example.com. Empty = relative links (they only work in the app).
BASE_URL=""
MAILTRAP_USER=""
MAILTRAP_PASSWORD=""
MAILGUN_USER=""
MAILGUN_PASSWORD=""
BREVO_USER=""
BREVO_PASSWORD=""
MAIL_RATE_LIMIT_MS=10500

# DETAILS
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_COMPANY_LOGO=""
NEXT_PUBLIC_COMPANY_ICON=""

# APP ENV
# PROD = production (enables HTTPS-only cookies for cross-site auth). Anything else = non-prod.
APP_ENV=""

# MAINTENANCE
# Exactly "true" puts the website into maintenance mode: every page redirects to
# /maintenance, except /admin and /login (staff) and /api (app + webhooks).
# Any other value leaves the site open.
# Public prefix: the value is inlined at build, so a change needs a redeploy
# (restart `next dev` locally).
NEXT_PUBLIC_IS_MAINTENANCE=""

# CORS
# Comma-separated exact origins allowed to call /api/* (scheme://host[:port]).
# Entries receive credentials (cookies allowed). Add "*" to also allow ANY origin for public
# endpoints (no credentials). Empty = same-origin only (default).
CORS_ORIGINS=""

# APP LINKS
# Comma-separated origins accepted as app return targets for mobile donations
# (successUrl / cancelUrl / billing-portal returnUrl). The path must be /donations/…
# Empty = fail closed: every mobile donation call is rejected with 422.
APP_LINK_ORIGINS="https://prayer-365.catatia.com,https://prayer365.eu"

STRIPE_ENABLED=true
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Platform Account ID (starts with 'acct_')
# Identifies the single centralized platform account for webhook attribution fallback.
STRIPE_PLATFORM_ACCOUNT_ID=""
PAYMENT_SYNC_WORKER_POLL_MS=5000

# REQUESTS
# Mobile request submissions allowed per user per church in a rolling window.
# Defaults: 5 per 10 minutes. Retries with the same Idempotency-Key never count.
REQUEST_SUBMIT_LIMIT=""
REQUEST_SUBMIT_WINDOW_MINUTES=""

GOOGLE_MAPS_API=""
# Browser Maps SDK key. Falls back to GOOGLE_MAPS_API when empty. Restrict it by
# HTTP referrer per environment; without a key the map renders a placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_API=""
# AdvancedMarkerElement mapId. Empty = DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# SITE / APP LINKS
# Used by the app promo section on the public /welcome page: the store badges
# and the download QR code. The QR encodes APP_STORE_URL, falling back to
# PLAY_STORE_URL when only that one is set. Empty = built-in store URLs.
# The hero badges always link to #app-promo, never straight to a store.
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_PLAY_STORE_URL=""
# Legacy aliases, read only when the two URLs above are empty.
NEXT_PUBLIC_IOS_APP_URL=""
NEXT_PUBLIC_ANDROID_APP_URL=""

# AI VOICE (worker runtime only)
# Must be exactly "true" for the audio/voice job controllers to call ElevenLabs.
ELEVENLABS_ENABLED=""
ELEVENLABS_API_KEY=""

# PUSH (FCM). The secret holds service-account JSON; the seeding CLI also accepts
# base64 of that JSON, or FIREBASE_SERVICE_ACCOUNT_FILE pointing at the .json.
# Absent = the notification.send worker fails with FIREBASE_SERVICE_ACCOUNT_MISSING.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_SERVICE_ACCOUNT_FILE=""
# Base64 32-byte AES-256-GCM key for device-token ciphertext. The device
# registration route encrypts and the worker decrypts, so both runtimes need the
# same value (Secrets Manager secret device-token-key).
DEVICE_TOKEN_KEY=""

# S3 READ URLS
# Optional override for media read URLs (e.g. a CDN in front of the bucket).
# Empty = https://<AWS_BUCKET_NAME>.s3.<AWS_REGION>.amazonaws.com/<key>
S3_PUBLIC_BASE_URL=""

# JOB WORKERS
# Local development runs the poll loops (`bun run worker:*`); the deployed
# workers are Lambda functions driven by SQS (see docs/admin/INFRA-DEPLOY.md).
AUDIO_WORKER_POLL_MS=5000
PRAYER_PUBLISH_WORKER_POLL_MS=5000
PAYMENT_SYNC_WORKER_POLL_MS=5000
VOICE_WORKER_POLL_MS=10000
MAIL_SEND_WORKER_POLL_MS=5000
NOTIFICATION_SEND_WORKER_POLL_MS=5000

# Job queue (Lambda dispatcher/consumer only; empty for the web app and for
# `bun run worker:*`, which read the outbox table directly).
JOBS_QUEUE_URL=""
JOB_CLAIM_LIMIT=10
# Outbox lease in seconds. Must stay >= the consumer Lambda timeout.
JOB_LEASE_SECONDS=900

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
