# CORS
# Comma-separated exact origins allowed to call /api/* (scheme://host[:port]).
# Entries receive credentials (cookies allowed). Add "*" to also allow ANY origin for public
# endpoints (no credentials). Empty = same-origin only (default).
CORS_ORIGINS=""

