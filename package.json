{
  "name": "catatia_dashboard_template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn prisma generate && yarn style-init && next dev",
    "build": "yarn prisma generate && yarn style-init && yarn prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "lefthook install",
    "format": "yarn prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "style-init": "tsx src/script/generate-sass-variable.ts",
    "update-dbdocs": "yarn prisma generate && dbdocs build prisma/dbml/schema.dbml --project catatia_dashboard"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.0.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@aws-sdk/client-s3": "^3.721.0",
    "@aws-sdk/s3-presigned-post": "^3.721.0",
    "@prisma/client": "^6.1.0",
    "@sparticuz/chromium": "^126.0.0",
    "@tanstack/react-query": "^5.81.5",
    "accesscontrol": "^2.2.1",
    "antd": "^5.22.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.3.2",
    "handlebars": "^4.7.8",
    "jose": "^6.2.12",
    "lottie-react": "^2.4.1",
    "next": "15.5.26",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^6.10.0",
    "prisma": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-player": "^2.16.0",
    "sass": "^1.77.8",
    "slugify": "^1.6.6",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.26",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "prisma-dbml-generator": "^0.12.0",
    "puppeteer": "^22.14.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
