{
  "name": "catatia_dashboard_template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun prisma generate && bun style-init && next dev",
    "build": "bun prisma generate && bun style-init && bun prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "lefthook install",
    "format": "bun prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "style-init": "tsx src/script/generate-sass-variable.ts",
    "seed:permissions": "bun src/script/seed-permissions.ts",
    "seed:media": "bun src/script/seed-media.ts",
    "seed:verify": "bun src/script/seed-verify.ts",
    "env:sync": "bun src/script/sync-env.ts",
    "seed:demo": "bun src/script/seed-media.ts && bunx tsx prisma/seed.ts && bun src/script/seed-verify.ts",
    "seed:viimsi": "bunx tsx prisma/seed-viimsi.ts",
    "request:submit": "bun src/script/submit-request.ts",
    "checkin:create": "bun src/script/check-in.ts",
    "worker:audio-generate": "bun workers/audio-generate.ts",
    "worker:prayer-publish": "bun workers/prayer-publish.ts",
    "worker:payment-sync": "bun workers/payment-sync.ts",
    "worker:voice-register": "bun workers/voice-register.ts",
    "worker:mail-send": "bun workers/mail-send.ts",
    "viimsi:voice-audio": "bunx tsx prisma/viimsi-voice-audio.ts",
    "update-dbdocs": "bun prisma generate && dbdocs build prisma/dbml/schema.dbml --project catatia_dashboard",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe --events payment_intent.succeeded,payment_intent.payment_failed,checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,charge.succeeded,charge.failed,charge.refunded,invoice.payment_succeeded,invoice.payment_failed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.721.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.721.0",
    "@aws-sdk/s3-presigned-post": "^3.721.0",
    "@aws-sdk/s3-request-presigner": "^3.721.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tanstack/react-query": "^5.81.5",
    "@vis.gl/react-google-maps": "^1.10.1",
    "accesscontrol": "^3.1.1",
    "antd": "^6.6.5",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "framer-motion": "^13.4.4",
    "handlebars": "^4.7.8",
    "jose": "^6.2.12",
    "lottie-react": "^3.1.2",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^10.0.11",
    "prisma": "^7.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-player": "^3.4.0",
    "react-quill-new": "^3.8.3",
    "sanitize-html": "^2.18.1",
    "sass": "^1.77.8",
    "slugify": "^1.6.6",
    "stripe": "^23.0.0",
    "swagger-ui-react": "^5.33.0",
    "uuid": "^14.0.2",
    "winston": "^3.13.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "postcss": "^8.5.28",
    "prettier": "^3.3.2",
    "prisma-dbml-generator": "^0.12.0",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.0",
    "tmp": "^0.2.6",
    "uuid@<11": "^11.1.1"
  }
}
